# =============================================================================
# .env.example — Environment Variable Reference
# =============================================================================
#
# PURPOSE: This file is committed to git. It documents every required env var
# and provides safe default values for local development.
#
# SECURITY:
#   - The actual .env file is NEVER committed (see .gitignore).
#   - In production, use a secrets manager (AWS SSM, HashiCorp Vault, GCP Secret
#     Manager) and inject secrets at container start time.
#   - SECRET_KEY MUST be regenerated for each environment using:
#     python -c "import secrets; print(secrets.token_hex(64))"
#
# USAGE:
#   cp .env.example .env   # Then fill in real values
#
# =============================================================================

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development                     # development | staging | production
APP_NAME=Mini Blinkit ERP
APP_VERSION=1.0.0
DEBUG=true                              # NEVER true in production
LOG_LEVEL=INFO                          # DEBUG | INFO | WARNING | ERROR | CRITICAL

# ── API ───────────────────────────────────────────────────────────────────────
API_PORT=8000
API_V1_PREFIX=/api/v1

# ── Security ──────────────────────────────────────────────────────────────────
# CRITICAL: Generate with: python -c "import secrets; print(secrets.token_hex(64))"
# This key signs all JWT tokens. Rotating it invalidates ALL active sessions.
SECRET_KEY=your-super-secret-key-changeme-in-production-minimum-64-chars-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Database ──────────────────────────────────────────────────────────────────
# WHY async URL: SQLAlchemy 2.0 with asyncpg requires postgresql+asyncpg://
# For Alembic (sync), a separate sync URL is derived automatically in config.py
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=erp_db
POSTGRES_USER=erp_user
POSTGRES_PASSWORD=erp_password
DATABASE_URL=postgresql+asyncpg://erp_user:erp_password@localhost:5432/erp_db
DATABASE_POOL_SIZE=20               # Connection pool size per worker
DATABASE_MAX_OVERFLOW=10            # Extra connections above pool_size
DATABASE_POOL_TIMEOUT=30            # Seconds to wait for a connection
DATABASE_POOL_RECYCLE=1800          # Recycle connections after 30 mins (prevents stale)

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password
REDIS_DB=0                          # DB 0 for application cache
REDIS_URL=redis://:redis_password@localhost:6379/0

# ── Celery ────────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://:redis_password@localhost:6379/1  # DB 1 for Celery
CELERY_RESULT_BACKEND=redis://:redis_password@localhost:6379/2

# ── Storage ───────────────────────────────────────────────────────────────────
# STORAGE_BACKEND: local | s3
# Switching to s3 only requires changing this value + AWS credentials below
STORAGE_BACKEND=local
MEDIA_ROOT=/app/media               # Absolute path inside container
MEDIA_URL=/media/                   # URL prefix for serving files

# AWS S3 (used when STORAGE_BACKEND=s3)
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=ap-south-1               # Mumbai region for India compliance
AWS_S3_BUCKET=erp-media-bucket
AWS_S3_ENDPOINT_URL=                # Leave blank for real S3. Set for MinIO: http://localhost:9000

# ── Flower (Celery Monitor) ────────────────────────────────────────────────────
FLOWER_PORT=5555
FLOWER_USER=admin
FLOWER_PASSWORD=flower_password

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@yourdomain.com
SMTP_PASSWORD=your-smtp-password
SMTP_TLS=true
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=Mini Blinkit ERP

# ── Sentry (Error Tracking) ───────────────────────────────────────────────────
# Leave blank to disable. Strongly recommended in production.
SENTRY_DSN=

# ── GST Configuration ─────────────────────────────────────────────────────────
# Company GST number — printed on PO PDFs, GRN PDFs, Delivery Challans
COMPANY_GST_NUMBER=29ABCDE1234F1Z5
COMPANY_STATE_CODE=29              # Karnataka = 29. Used for SGST/CGST vs IGST split
COMPANY_NAME=Mini Blinkit Private Limited
COMPANY_ADDRESS=123 Warehouse Road, Bengaluru, Karnataka - 560001
COMPANY_PHONE=+91-9876543210
COMPANY_EMAIL=operations@miniblinkit.com

# ── Pagination Defaults ───────────────────────────────────────────────────────
DEFAULT_PAGE_SIZE=25
MAX_PAGE_SIZE=200

# ── Stock Reservation ─────────────────────────────────────────────────────────
STOCK_RESERVATION_TIMEOUT_SECONDS=60  # 60-second customer order reservation window
